# Copia este archivo como .env y pega los IDs de tu proyecto de Appwrite.
# Todos llevan el prefijo VITE_ para que Vite los exponga al navegador.
# (Son IDs públicos, no secretos: la seguridad la ponen los permisos.)

# URL de la API. En Appwrite Cloud sería https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=http://localhost/v1

# Consola > tu proyecto > Overview (o Settings) > Project ID
VITE_APPWRITE_PROJECT_ID=

# Consola > Databases > tu base de datos > Database ID
VITE_APPWRITE_DATABASE_ID=muro

# Consola > Databases > tu base de datos > tabla "mensajes" > Table ID
VITE_APPWRITE_TABLE_ID=mensajes

# Consola > Storage > bucket "fotos" > Bucket ID
VITE_APPWRITE_BUCKET_ID=fotos
